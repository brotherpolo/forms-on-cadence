# Copy to .env.local and fill in from your Cadence firebase-config.js
# (Firebase console → Project settings → Your apps, project tasks-2ae9d).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=tasks-2ae9d
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local emulators instead (started from the Cadence folder).
VITE_USE_EMULATORS=false
